# Copy to .env and fill in. Keys come from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
# Sandbox secret: Plaid's test banks, to try the app.
PLAID_SANDBOX_SECRET=
# Production secret: your real banks.
PLAID_PRODUCTION_SECRET=
# Which one the app uses: sandbox or production
PLAID_ENV=sandbox
# Your time zone, so the app's "today" is yours (for example America/Chicago). Empty means UTC.
TZ=
# Optional: hours between automatic syncs (0 turns them off; daily backups go on)
# SYNC_INTERVAL_HOURS=6
# Optional: the names your other devices reach this computer by, through a private network (see docs/remote-access.md)
# REMOTE_HOSTS=my-computer.my-tailnet.ts.net
